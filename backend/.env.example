HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Choose ONE AI provider (all FREE, no credit card)

# Option 1: Groq (RECOMMENDED - fastest, free forever)
# AI_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here

# Option 2: Google Gemini (FREE - get from ai.google.dev)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here

# Option 3: Hugging Face (FREE - get from huggingface.co)
# AI_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your_hf_key_here

CACHE_EXPIRY_MINUTES=15
MAX_REQUESTS_PER_MINUTE=60
